PORT=8080
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/smartlearn
TEST_MONGO_URI=mongodb://127.0.0.1:27017/smartlearn_test
JWT_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
# Optional SMTP configuration. Without these, password reset links are shown only in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=SmartLearn <no-reply@example.com>
