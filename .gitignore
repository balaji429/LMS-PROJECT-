# Package dependencies and package manager caches
node_modules/
.pnp/
.pnp.*

# Build output and test reports
**/dist/
**/build/
**/coverage/
**/.vite/
**/.turbo/

# Local environment files; keep safe templates available to Git
.env
.env.*
!.env.example

# Logs and temporary files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp

# Uploaded user files are local data, not application source
server/uploads/*
!server/uploads/.gitkeep

# Operating system and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

docs/
